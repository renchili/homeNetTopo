{
  "name": "homeNetTopo",
  "display_name": "Home Net Topology",
  "version": "0.1.0",
  "status": "implemented-unverified",
  "platform": "macOS",
  "runtime": {
    "python_minimum": "3.10",
    "python_production_dependencies": "standard-library-only",
    "native_helper": "Swift with AppKit/SwiftUI, CoreLocation, CoreWLAN, and ServiceManagement system frameworks",
    "native_build_tool": "Xcode command-line tools",
    "frontend_test_runtime": "Node.js 20+ built-in test runner"
  },
  "entrypoint": "python3 server.py",
  "surface": "local web application plus current-user native Wi-Fi identity helper",
  "local_bind": "127.0.0.1",
  "default_port": 8765,
  "network_scope": "requested RFC 1918 IPv4 networks equal to or contained by eligible non-tunnel local interface networks",
  "collection_api": {
    "passive_refresh": "POST /api/v1/topology/refresh",
    "active_discovery": "POST /api/v1/discover",
    "read_only_topology": "GET /api/v1/topology",
    "export": "GET /api/v1/topology/export",
    "custom_header": "X-HomeNetTopo-Request: 1"
  },
  "passive_evidence": {
    "interface_command": "/sbin/ifconfig -a",
    "route_command": "/usr/sbin/netstat -rn -f inet",
    "neighbor_command": "/usr/sbin/arp -an",
    "wifi_interface_command": "/usr/sbin/networksetup -listallhardwareports",
    "wifi_detail_command": "/usr/sbin/system_profiler -json -timeout 5 SPAirPortDataType",
    "commands_run_concurrently": true,
    "wifi_current_association_only": true,
    "nearby_wifi_scan_retained": false,
    "wifi_detail_failure_is_optional": true,
    "wifi_current_mac_source": "ifconfig ether",
    "wifi_hardware_mac_source": "networksetup Ethernet Address",
    "wifi_bssid_source": "Location-authorized native CoreWLAN helper, then system_profiler current association, then optional local fallback",
    "wifi_bssid_precedence": ["wifi_native", "wifi", "local_configuration"],
    "wifi_local_fallback_supported": true,
    "automatic_bssid_precedes_fallback": true,
    "ethernet_adjacent_device_source": "not_available_without_lldp"
  },
  "native_wifi_helper": {
    "bundle_id": "com.homenettopo.wifi",
    "install_path": "~/Applications/HomeNetTopo Wi-Fi.app",
    "cache_path": "~/Library/Caches/HomeNetTopo/wifi-current.json",
    "cache_schema_version": 1,
    "cache_update_seconds": 5,
    "cache_max_age_seconds": 20,
    "location_permission_required_for_ssid_bssid": true,
    "login_launch_owner": "SMAppService.mainApp",
    "login_launch_may_require_user_approval": true,
    "native_identity_values_exposed_by_capabilities": false,
    "manual_bssid_required": false
  },
  "active_discovery": {
    "enabled_by_default": false,
    "method": "nmap -sn -n --max-retries 1 --host-timeout 5s -oX -",
    "output_format": "xml-stdout",
    "max_networks_per_request": 32,
    "max_addresses_per_request": 1024,
    "operation_timeout_default_seconds": 30,
    "operation_timeout_min_seconds": 5,
    "operation_timeout_max_seconds": 120,
    "nmap_host_timeout_seconds": 5
  },
  "http_limits": {
    "max_json_body_bytes": 16384
  },
  "command_limits": {
    "passive_timeout_seconds": 5,
    "wifi_interface_timeout_seconds": 3,
    "wifi_timeout_seconds": 8,
    "stdout_bytes": 2097152,
    "stderr_bytes": 65536,
    "kill_grace_seconds": 2
  },
  "snapshot_policy": {
    "persistence": "process-memory-only",
    "automatic_ttl": false,
    "read_only_gets_start_commands": false,
    "max_concurrent_collections": 1,
    "failed_collection_preserves_previous": true
  },
  "capability_disclosure": {
    "nmap_full_path_exposed": false,
    "nmap_resolution_source_exposed": true,
    "unsupported_platform_reason": "unsupported_platform",
    "nmap_state_visible_in_ui": true,
    "nmap_recheck_action_when_unavailable": true,
    "wifi_native_helper_state_exposed": true,
    "wifi_identity_values_exposed": false,
    "wifi_fallback_values_exposed": false,
    "wifi_fallback_presence_exposed": true
  },
  "gateway_path": {
    "wifi_attachment": "BSSID identifies the current connected Wi-Fi radio; role remains access point or relay unless an approved source confirms it",
    "wifi_native_identity": "fresh Location-authorized CoreWLAN BSSID is preferred and high-confidence association evidence",
    "wifi_without_bssid": "connected Wi-Fi node remains visible without invented identity and with an actionable native-helper state",
    "wifi_local_identity": "current/private MAC and adapter hardware MAC remain on the local host and interface",
    "wifi_serving_identity": "BSSID remains only on the connected Wi-Fi node",
    "ethernet_attachment_without_lldp": "Intermediate L2 path unknown",
    "different_ap_and_gateway_macs": "not_established physical identity relation",
    "same_ap_and_gateway_mac": "same_mac positive relation",
    "subnet_devices_are_transit_hops": false,
    "tunnels_remain_visible": true
  },
  "graph_layout": {
    "coordinate_convention": "top-left-world-coordinates",
    "node_width": 156,
    "node_height": 60,
    "minimum_horizontal_gap": 38,
    "minimum_vertical_gap": 20,
    "main_path": "local-host-interface-wifi-attachment-gateway-upstream",
    "peer_layout": "subnet-context-groups-below-path",
    "camera": "svg-viewbox"
  },
  "first_release_exclusions": [
    "reverse-dns-enrichment",
    "online-hostname-or-vendor-lookup",
    "persistent-snapshots",
    "lan-bind",
    "active-ipv6-discovery",
    "port-or-service-scanning",
    "guaranteed-ethernet-switch-enumeration",
    "automatic-proof-of-wifi-relay-role"
  ],
  "verification": {
    "source_generated": true,
    "tests_defined": true,
    "tests_executed": false,
    "native_xcode_build_executed": false,
    "location_authorization_executed": false,
    "corewlan_runtime_executed": false,
    "browser_executed": false,
    "real_network_executed": false,
    "ci_executed": false
  },
  "privacy": {
    "cloud_required": false,
    "telemetry_required": false,
    "external_frontend_assets_required": false,
    "automatic_snapshot_persistence": false,
    "native_cache_is_user_local": true,
    "commit_real_ssid_or_bssid": false,
    "commit_launch_agent_plist": false
  }
}
