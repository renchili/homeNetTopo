{
  "name": "homeNetTopo",
  "display_name": "Home Net Topology",
  "status": "bootstrap",
  "platform": "macOS",
  "runtime": {
    "python_minimum": "3.10",
    "production_dependencies": "standard-library-only",
    "frontend_test_runtime": "Node.js 20+ built-in test runner"
  },
  "surface": "local web application",
  "local_bind": "127.0.0.1",
  "default_port": 8765,
  "network_scope": "locally visible private IPv4 networks on eligible non-tunnel interfaces",
  "active_discovery": {
    "enabled_by_default": false,
    "method": "nmap -sn -n",
    "max_networks_per_request": 32,
    "max_addresses_per_request": 1024,
    "timeout_default_seconds": 30,
    "timeout_min_seconds": 1,
    "timeout_max_seconds": 120
  },
  "http_limits": {
    "max_json_body_bytes": 16384
  },
  "command_limits": {
    "passive_timeout_seconds": 5,
    "stdout_bytes": 2097152,
    "stderr_bytes": 65536,
    "kill_grace_seconds": 2
  },
  "first_release_exclusions": [
    "reverse-dns-enrichment",
    "online-hostname-or-vendor-lookup",
    "user-annotations",
    "persistent-snapshots",
    "lan-bind",
    "active-ipv6-discovery"
  ],
  "privacy": {
    "cloud_required": false,
    "telemetry_required": false,
    "external_frontend_assets_required": false,
    "automatic_persistence": false
  },
  "product_prompt": "On a Mac, collect local interface, IPv4 routing, gateway, ARP and optional bounded Nmap host-discovery evidence; infer a best-effort logical home-network topology; and display observed facts and inferred relationships in an interactive loopback-only web page without claiming complete physical visibility."
}
